<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.DirectOrderListController">
   <children>
    <Button fx:id="btNew" mnemonicParsing="false" onAction="#onBtNewAction" styleClass="new-button" text="Novo Pedido">
         <VBox.margin>
            <Insets bottom="5.0" left="15.0" />
         </VBox.margin>
      </Button>
      <VBox alignment="CENTER_RIGHT" prefHeight="50.0" prefWidth="100.0">
         <children>
            <DatePicker fx:id="dpDate" />
            <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="200.0">
               <VBox.margin>
                  <Insets bottom="5.0" top="5.0" />
               </VBox.margin>
               <children>
                  <Button fx:id="btsearch" mnemonicParsing="false" onAction="#onBtSearchAction" text="Pesquisar" />
                  <Button fx:id="btclear" mnemonicParsing="false" onAction="#onBtClearAction" text="Limpar">
                     <HBox.margin>
                        <Insets left="5.0" right="5.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
      <TableView fx:id="tableViewDirectOrder" styleClass="table" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="tableColumnIndex" prefWidth="56.0" text="Id" />
          <TableColumn fx:id="tableColumnOrderValue" prefWidth="75.0" text="Valor" />
            <TableColumn fx:id="tableColumnDeliveryValue" prefWidth="75.0" text="Entrega" />
            <TableColumn fx:id="tableColumnPaymentMethod" prefWidth="170.0" text="Metódo de Pagamento" />
            <TableColumn id="removeButton" fx:id="tableColumnRemove" prefWidth="124.0" />
        </columns>
         <VBox.margin>
            <Insets top="5.0" />
         </VBox.margin>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
