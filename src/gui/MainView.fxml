<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.MainViewController">
	<left>
		<VBox prefWidth="100.0" styleClass="side-bar" BorderPane.alignment="CENTER">
			<children>
            <VBox alignment="CENTER" spacing="4.0">
               <VBox.margin>
                  <Insets bottom="20.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
               <children>
      				<Button fx:id="btIfoodOrder" mnemonicParsing="false" onAction="#onBtIfoodOrderAction" />
                  <Label text="Pedidos Ifood" />
               </children>
            </VBox>
            <VBox alignment="CENTER" spacing="4.0">
               <VBox.margin>
                  <Insets bottom="20.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
               <children>
      				<Button fx:id="btDirectOrder" mnemonicParsing="false" onAction="#onBtDirectOrderAction" />
                  <Label text="Pedidos PV" />
               </children>
            </VBox>
            <VBox alignment="CENTER" spacing="4.0">
               <VBox.margin>
                  <Insets left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
               <children>
      				<Button fx:id="btResult" mnemonicParsing="false" onAction="#onBtResultAction" />
                  <Label text="Balanço" />
               </children>
            </VBox>
			</children>
		</VBox>
	</left>
	<center>
		<VBox styleClass="main-vbox" BorderPane.alignment="CENTER">
			<children>
				<Label id="screenIformation" fx:id="screenInformation">
					<VBox.margin>
						<Insets bottom="20.0" left="15.0" top="10.0" />
					</VBox.margin>
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
				</Label>
				<VBox fx:id="contentHolder" VBox.vgrow="ALWAYS">
					<VBox.margin>
						<Insets />
					</VBox.margin>
				</VBox>
			</children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
		</VBox>
	</center>
</BorderPane>
